#: includes/admin/views/tab-settings.php:178
#: includes/class-sccm-report.php:382
#: includes/class-sccm-report.php:812
msgid "Weekly consent report"
msgstr ""

#: includes/admin/views/tab-help.php:177
msgid "Every Monday, at the same time, a report of the last 7 days for the same people: how many visitors answered the banner, what they chose day by day, what they allowed, the last 8 weeks and the banner status, with charts. \"Send report now\" sends it at any time."
msgstr ""

#: includes/admin/views/tab-help.php:178
msgid "Consent records"
msgstr ""

#: includes/admin/views/tab-help.php:178
msgid "Whether to keep a record of every choice, how the visitor's IP address is stored (shortened with ***, a one-way code, in full, or not at all), and how many months records are kept."
msgstr ""

#: includes/admin/views/tab-help.php:189
msgid "The table"
msgstr ""

#: includes/admin/views/tab-help.php:189
msgid "One line per choice: when (UTC), the consent ID, the choice, the categories allowed, whether a privacy signal was used, the banner version agreed to, the page and the IP address in the form you chose."
msgstr ""

#: includes/admin/views/tab-help.php:190
msgid "Search and filters"
msgstr ""

#: includes/admin/views/tab-help.php:190
msgid "Paste a consent ID or an IP address, or filter by choice, banner version or date."
msgstr ""

#: includes/admin/views/tab-help.php:191
msgid "Banner versions"
msgstr ""

#: includes/admin/views/tab-help.php:191
msgid "The box at the top lists every banner version with records: when it started, why, and how many records it has."
msgstr ""

#: includes/admin/views/tab-help.php:192
msgid "Export CSV"
msgstr ""

#: includes/admin/views/tab-help.php:192
msgid "Downloads the records with your current filters as a spreadsheet file, for audits."
msgstr ""

#: includes/admin/views/tab-help.php:193
#: includes/admin/views/tab-records.php:237
msgid "Test record saving"
msgstr ""

#: includes/admin/views/tab-help.php:193
msgid "Checks that your server accepts records from visitors (a firewall can block them)."
msgstr ""

#: includes/admin/views/tab-help.php:194
msgid "Delete old / Delete all"
msgstr ""

#: includes/admin/views/tab-help.php:194
msgid "Removes records older than your retention period, or every record. Deleting all cannot be undone."
msgstr ""

#: includes/admin/views/tab-help.php:205
#: includes/admin/views/tab-tools.php:22
msgid "Ask all visitors again"
msgstr ""

#: includes/admin/views/tab-help.php:205
msgid "Starts a new banner version: everyone sees the banner again, for example after you change how you use cookies."
msgstr ""

#: includes/admin/views/tab-help.php:206
msgid "Export / Import settings"
msgstr ""

#: includes/admin/views/tab-help.php:206
msgid "Copies all settings and your cookie list to a file, so you can use the same setup on another website."
msgstr ""

#: includes/admin/views/tab-help.php:207
#: includes/admin/views/tab-tools.php:46
msgid "Delete all data when the plugin is deleted"
msgstr ""

#: includes/admin/views/tab-help.php:207
msgid "Off by default, so your consent records survive. Turn it on only for a clean removal."
msgstr ""

#: includes/admin/views/tab-help.php:208
#: includes/admin/views/tab-tools.php:51
msgid "Reset settings to defaults"
msgstr ""

#: includes/admin/views/tab-help.php:208
msgid "Puts every setting back to how it was at the start. Your cookie list and records are kept."
